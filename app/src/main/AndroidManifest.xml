<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Reading the phone's photos and videos (Phase 2). Asked for only when the user taps "Allow access".
         Android 11-12 use storage access; 13+ ask for images and videos; 14+ may share only selected photos. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Where photos were taken, for the viewer's details panel. Read on the phone only. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- Backup (Phase 4): progress and "backup didn't finish" notifications, and a foreground job while a long
         backup or restore runs. WorkManager keeps scheduled backups across restarts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Lets "Open in Maps" find a maps app on Android 11+ (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".PixalleryApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_leaf_light"
        android:roundIcon="@mipmap/ic_leaf_light"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoVault">

        <!-- WorkManager's own service runs long backups in the foreground; Android 14+ needs its type. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!-- App icons. Exactly one is enabled at a time; Settings > Appearance > App icon switches between them.
             Leaf on light is the default (23 Oct 2026; was Four Seasons on light). -->
        <activity-alias
            android:name=".IconFourSeasonsLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_light"
            android:roundIcon="@mipmap/ic_four_seasons_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconFourSeasonsDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_dark"
            android:roundIcon="@mipmap/ic_four_seasons_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconFourSeasonsColourful"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_colourful"
            android:roundIcon="@mipmap/ic_four_seasons_colourful"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconFourSeasonsClear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_clear"
            android:roundIcon="@mipmap/ic_four_seasons_clear"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Retired Bloom icons (24 Oct): kept switched off so a phone that used Bloom keeps a home-screen entry until
             the app moves it to Four Seasons on the same background. -->
        <activity-alias
            android:name=".IconBloomLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_light"
            android:roundIcon="@mipmap/ic_four_seasons_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBloomDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_dark"
            android:roundIcon="@mipmap/ic_four_seasons_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBloomColourful"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_colourful"
            android:roundIcon="@mipmap/ic_four_seasons_colourful"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBloomClear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_four_seasons_clear"
            android:roundIcon="@mipmap/ic_four_seasons_clear"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLeafLight"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_leaf_light"
            android:roundIcon="@mipmap/ic_leaf_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLeafDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_leaf_dark"
            android:roundIcon="@mipmap/ic_leaf_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLeafColourful"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_leaf_colourful"
            android:roundIcon="@mipmap/ic_leaf_colourful"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconLeafClear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_leaf_clear"
            android:roundIcon="@mipmap/ic_leaf_clear"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPetalsLight"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_petals_light"
            android:roundIcon="@mipmap/ic_petals_light"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPetalsDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_petals_dark"
            android:roundIcon="@mipmap/ic_petals_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPetalsColourful"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_petals_colourful"
            android:roundIcon="@mipmap/ic_petals_colourful"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPetalsClear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_petals_clear"
            android:roundIcon="@mipmap/ic_petals_clear"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
